# Optional but recommended for real multi-user accounts and shared listings.
# Create a project at https://supabase.com, then copy its Project URL and anon/public key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set the owner email used to show the property management panel (only after Supabase auth is configured).
VITE_OWNER_EMAIL=your-email@example.com